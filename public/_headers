# Netlify response headers. Vite copies public/ into dist/ as-is.
# Everything under /assets has a content hash in its filename (JS, CSS,
# climate.json), so it can be cached forever. index.html keeps Netlify's
# default (always revalidated) so new deploys show up immediately.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
